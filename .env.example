# Canonical HTTPS origin used to generate QR/NFC links. Do not include a
# trailing slash. Example: https://bio-tag.web.app
VITE_PUBLIC_APP_URL="https://YOUR_DOMAIN"

# Public reCAPTCHA Enterprise site key registered for the production domain.
# Cloud Functions enforce Firebase App Check, so this is required in production.
VITE_FIREBASE_APPCHECK_SITE_KEY="YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY"
