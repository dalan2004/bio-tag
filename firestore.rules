rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isActive() {
      return hasProfile() && profile().active == true;
    }

    function belongsTo(institutionId) {
      return isActive() && profile().institutionId == institutionId;
    }

    function hasRole(role) {
      return isActive() && profile().role == role;
    }

    function isAdmin(institutionId) {
      return belongsTo(institutionId) && hasRole('admin_hospital');
    }

    function isEngineerOrAdmin(institutionId) {
      return belongsTo(institutionId) &&
        (profile().role == 'ingeniero' || profile().role == 'admin_hospital');
    }

    function validId(value) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= 128 &&
        value.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function validRole(value) {
      return value in ['ingeniero', 'admin_hospital', 'enfermeria', 'consulta'];
    }

    function validUser(data, userId) {
      return data.keys().hasOnly([
          'id', 'email', 'fullName', 'role', 'institutionId', 'rh',
          'cargo', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.id == userId &&
        data.email is string && data.email.size() <= 254 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 150 &&
        validRole(data.role) &&
        validId(data.institutionId) &&
        data.cargo is string && data.cargo.size() <= 100 &&
        data.active is bool;
    }

    function validInstitution(data, institutionId) {
      return data.keys().hasOnly([
          'id', 'name', 'city', 'department', 'address', 'phone',
          'requireLoginForScan', 'nextConsecutive', 'createdAt', 'updatedAt'
        ]) &&
        data.id == institutionId &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 200 &&
        data.city is string && data.city.size() <= 100 &&
        data.department is string && data.department.size() <= 100 &&
        data.address is string && data.address.size() <= 200 &&
        data.phone is string && data.phone.size() <= 50 &&
        data.requireLoginForScan is bool &&
        data.nextConsecutive is int && data.nextConsecutive >= 1;
    }

    match /system/{documentId} {
      allow read, write: if false;
    }

    match /companies/{companyId} {
      allow get: if companyId == 'main';
      allow list: if false;
      allow create: if false;
      allow update: if companyId == 'main' &&
        isActive() && profile().role == 'admin_hospital' &&
        request.resource.data.id == 'main' &&
        request.resource.data.keys().hasOnly([
          'id', 'nombre', 'nit', 'eslogan', 'logoUrl', 'direccion',
          'ciudad', 'correo', 'telefonos', 'colorPrincipal', 'updatedAt'
        ]) &&
        request.resource.data.nombre is string && request.resource.data.nombre.size() <= 200 &&
        request.resource.data.nit is string && request.resource.data.nit.size() <= 60 &&
        request.resource.data.logoUrl is string && request.resource.data.logoUrl.size() <= 2048;
      allow delete: if false;
    }

    match /institutions/{institutionId} {
      allow get: if belongsTo(institutionId);
      allow list: if false;
      allow create: if isActive() && profile().role == 'admin_hospital' &&
        validInstitution(request.resource.data, institutionId);
      allow update: if isAdmin(institutionId) &&
        validInstitution(request.resource.data, institutionId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.nextConsecutive == resource.data.nextConsecutive;
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isActive() && (
        request.auth.uid == userId ||
        profile().institutionId == resource.data.institutionId
      );
      allow list: if isActive() &&
        profile().role == 'admin_hospital' &&
        resource.data.institutionId == profile().institutionId;
      allow create, delete: if false;
      allow update: if isActive() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'cargo', 'updatedAt']) &&
        validUser(request.resource.data, userId);
    }

    match /equipments/{equipmentId} {
      allow get: if belongsTo(resource.data.institutionId);
      allow list: if belongsTo(resource.data.institutionId);
      allow create, update, delete: if false;
    }

    match /maintenances/{maintenanceId} {
      allow get: if belongsTo(resource.data.institutionId);
      allow list: if belongsTo(resource.data.institutionId);
      allow create, update, delete: if false;
    }

    match /incidents/{incidentId} {
      allow get: if belongsTo(resource.data.institutionId);
      allow list: if belongsTo(resource.data.institutionId);
      allow create, update, delete: if false;
    }

    match /audit_logs/{auditId} {
      allow get: if isEngineerOrAdmin(resource.data.institutionId);
      allow list: if isEngineerOrAdmin(resource.data.institutionId);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
