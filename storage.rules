rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isActive() {
      return signedIn() && request.auth.token.active == true;
    }

    function validImage() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /company_logos/main/{fileName} {
      allow read: if true;
      allow write: if isActive() &&
        request.auth.token.role == 'admin_hospital' && validImage();
    }

    match /institutions/{institutionId}/equipment_photos/{fileName} {
      allow read: if isActive() && request.auth.token.institutionId == institutionId;
      allow write: if isActive() &&
        request.auth.token.institutionId == institutionId &&
        request.auth.token.role == 'ingeniero' && validImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
